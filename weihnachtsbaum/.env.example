# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte beim Hoster ein (Vercel → Settings → Environment Variables).

# Öffentliche Adresse der Website, ohne Schrägstrich am Ende
NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# Admin-Bereich /admin – mindestens 8 Zeichen, am besten deutlich länger
ADMIN_PASSWORD=

# Postgres-Datenbank (Supabase: Project Settings → Database → Connection string → "Transaction pooler")
# Lokal weglassen: dann wird automatisch eine eingebettete Testdatenbank im Ordner .data/ benutzt.
DATABASE_URL=

# Stripe – zuerst die TEST-Schlüssel (sk_test_…). Ohne Schlüssel läuft der Shop im Demo-Modus ohne Zahlung.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-Mail über Resend. Ohne Schlüssel werden E-Mails nur ins Server-Log geschrieben.
RESEND_API_KEY=
EMAIL_FROM="Firmenname <bestellung@deine-domain.de>"
# An diese Adresse gehen Benachrichtigungen über neue Bestellungen und Anfragen
OPERATOR_EMAIL=
